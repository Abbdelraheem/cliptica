# ==============================================================================
# CLIPZILA - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env.local (development) or .env.production (production).
# Fill in the appropriate secrets before starting the application.
# ==============================================================================

# ==============================================================================
# 1. DATABASE (Required)
# ==============================================================================
# PostgreSQL connection string.
# Required for Prisma ORM (User accounts, projects, clips, transactions, settings).
# Where to get it: Neon.tech, AWS RDS, Supabase, or local PostgreSQL.
# Example: postgresql://postgres:password@localhost:5432/clipzila?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/clipzila?schema=public"

# ==============================================================================
# 2. AUTHENTICATION - NEXTAUTH v4 (Required)
# ==============================================================================
# Canonical public URL of the application. Used for OAuth redirects and email callbacks.
# Development: http://localhost:3000 | Production: https://clipzila.com
NEXTAUTH_URL="http://localhost:3000"

# Secret key used to sign and encrypt NextAuth JWT session tokens.
# Required in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Token encryption secret (AES-256-GCM) for social OAuth tokens at rest.
# Optional: falls back to NEXTAUTH_SECRET if not provided.
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET="generate-with-openssl-rand-base64-32"

# Comma-separated list of admin email addresses with superuser permissions.
# Optional: defaults to abbdelraheem@gmail.com
ADMIN_EMAILS="admin@clipzila.com"

# ==============================================================================
# 3. OAUTH PROVIDERS (Optional)
# ==============================================================================
# Google OAuth 2.0. When set, "Continue with Google" button is displayed on login/register.
# Where to get it: Google Cloud Console -> APIs & Services -> Credentials
# Authorized Redirect URI: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth. Optional fallback provider.
# Where to get it: GitHub -> Settings -> Developer Settings -> OAuth Apps
# Authorized Redirect URI: https://yourdomain.com/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ==============================================================================
# 4. STORAGE - CLOUDFLARE R2 / AWS S3 (Required for video uploads & rendering)
# ==============================================================================
# S3-compatible object storage endpoint for source videos and rendered vertical clips.
# Where to get it: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_BUCKET="clipzila-clips"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Optional public custom domain mapped to your bucket (for direct streaming/downloads):
NEXT_PUBLIC_R2_PUBLIC_URL="https://clips.clipzila.com"

# ==============================================================================
# 5. AI ENGINES & MOMENT SCORING (Required for transcription & AI clipping)
# ==============================================================================
# Groq API Key: Fast Whisper transcription and LLaMA 3.3 moment scoring.
# Required for primary pipeline.
# Where to get it: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_SCORE_MODEL="llama-3.3-70b-versatile"
WHISPER_MODEL="whisper-large-v3-turbo"

# NVIDIA NIM Frontier Model (Optional: highest-tier scoring in resilient fallback chain)
# Where to get it: https://build.nvidia.com
NVIDIA_API_KEY=""
NVIDIA_SCORE_MODEL="deepseek-ai/deepseek-v4.1-flash"

# OpenAI API Key (Optional: fallback tier when Groq and NVIDIA are rate-limited)
# Where to get it: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# ==============================================================================
# 6. PAYMENTS & BILLING (At least one provider active in production)
# ==============================================================================

# --- Paddle (Default Production Billing in Clipzila) ---
# Where to get it: https://vendors.paddle.com -> Developer Tools -> Authentication
PADDLE_API_KEY=""
PADDLE_NOTIFICATION_WEBHOOK_SECRET=""
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
# Environment: 'sandbox' for testing or 'production' for live
NEXT_PUBLIC_PADDLE_ENV="production"
# Price IDs from Paddle Catalog:
NEXT_PUBLIC_PADDLE_PRICE_BASIC_MONTHLY=""
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTHLY=""
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=""

# --- Stripe (Alternative Billing Provider) ---
# Where to get it: https://dashboard.stripe.com/apikeys and Webhooks
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_CLIPPER_MONTHLY=""
STRIPE_PRICE_STUDIO_MONTHLY=""

# --- Whop (Bounty & Digital Product Ingestion) ---
# Where to get it: https://whop.com/developers
WHOP_API_KEY=""
WHOP_WEBHOOK_SECRET=""

# ==============================================================================
# 7. TRANSACTIONAL EMAIL - RESEND (Optional)
# ==============================================================================
# Sends email verification, password reset, and billing receipts.
# If unset, email links are printed to the application console for local development.
# Where to get it: https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Clipzila <noreply@clipzila.com>"

# Set to "true" to require new users to verify their email address before accessing the app.
# Default: "false" (email verification is turned off; users are immediately active upon registration).
REQUIRE_EMAIL_VERIFICATION="false"

# ==============================================================================
# 8. RATE LIMITING - UPSTASH REDIS (Optional)
# ==============================================================================
# Protects authentication routes (/api/auth/*) and expensive AI generation APIs.
# If unset, an in-memory token bucket rate limiter is used.
# Where to get it: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ==============================================================================
# 9. MONITORING & ERROR TRACKING (Optional)
# ==============================================================================
# Client & server error monitoring.
# Where to get it: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=""

# ==============================================================================
# 10. APPLICATION SETTINGS & WORKER TUNING (Optional)
# ==============================================================================
# Public app base URL for CORS and links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Eligibility gate (minimum credits required to queue a project)
MIN_CREDITS_REQUIRED="1"

# Maximum upload file size in Megabytes (default: 500)
MAX_UPLOAD_MB="500"

# Worker cleanup threshold for stuck jobs (default: 30 minutes)
STALE_JOB_MINUTES="30"

# Parallel clip rendering processes on the worker
RENDER_PARALLEL="4"

# ==============================================================================
# 11. SOCIAL PLATFORM PUBLISHING (Optional)
# ==============================================================================
# Direct publishing to TikTok, YouTube Shorts, and Instagram Reels.

# TikTok Content Posting API: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
NEXT_PUBLIC_TIKTOK_REDIRECT_URI=""

# YouTube Data API v3: https://console.cloud.google.com
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
NEXT_PUBLIC_YOUTUBE_REDIRECT_URI=""

# Instagram Graph API (Reels): https://developers.facebook.com
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=""
