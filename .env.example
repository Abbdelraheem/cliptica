# ============ Database ============
DATABASE_URL="postgresql://user:password@localhost:5432/cliptica?schema=public"

# ============ Auth (NextAuth v4) ============
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# OAuth providers (optional — provider buttons hide themselves when unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ============ Stripe ============
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_CLIPPER_MONTHLY="price_..."
STRIPE_PRICE_STUDIO_MONTHLY="price_..."

# ============ Cloudflare R2 (worker storage) ============
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
R2_BUCKET="nology-clips"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# ============ AI (Groq primary, OpenAI fallback) ============
GROQ_API_KEY=""
GROQ_SCORE_MODEL="llama-3.3-70b-versatile"
WHISPER_MODEL="whisper-large-v3-turbo"
OPENAI_API_KEY=""            # optional scoring fallback

# ============ Email (password reset / verification; optional) ============
RESEND_API_KEY=""            # unset → links are logged to the worker console
EMAIL_FROM="NOLOGY <noreply@getnology.com>"

# ============ Rate limiting (optional; unset → limits disabled) ============
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============ Error tracking (optional) ============
NEXT_PUBLIC_SENTRY_DSN=""    # Sentry or Sentry-compatible (GlitchTip)

# ============ App ============
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # used for CORS + email links

# ---- Tuning (all optional, sane defaults in code) ----
MIN_CREDITS_REQUIRED="10"    # eligibility gate to start a project
MAX_UPLOAD_MB="500"
STALE_JOB_MINUTES="30"       # processing jobs older than this get requeued
RENDER_PARALLEL="4"
CLIPS_PER_VIDEO="6"
CLIP_TARGET_SECONDS="38"
PIPELINE_PREMIUM="1"         # 0 degrades to center-crop pipeline
STATIC_EXPORT="0"            # 1 → static site build for GitHub Pages

# ============ Token Encryption (AES-256-GCM) ============
# Secret used to encrypt social OAuth tokens at rest. Falls back to NEXTAUTH_SECRET if unset.
ENCRYPTION_SECRET="generate-with: openssl rand -base64 32"

# ============ Social Direct Publishing Credentials ============
# TikTok Content Posting API
# Register at: https://developers.tiktok.com
# Required Scopes: user.info.basic, video.publish, video.upload
# Redirect URI: https://yourdomain.com/api/social/tiktok/callback
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
NEXT_PUBLIC_TIKTOK_REDIRECT_URI=""

# YouTube Data API v3
# Register at: https://console.cloud.google.com/apis/credentials
# Enable: YouTube Data API v3
# Required Scopes: https://www.googleapis.com/auth/youtube.upload, https://www.googleapis.com/auth/userinfo.profile
# Redirect URI: https://yourdomain.com/api/social/youtube/callback
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
NEXT_PUBLIC_YOUTUBE_REDIRECT_URI=""

# Instagram Graph API (Reels via Meta for Developers)
# Register at: https://developers.facebook.com
# Products: Instagram Graph API, Facebook Login for Business
# Required Scopes: instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement
# Redirect URI: https://yourdomain.com/api/social/instagram/callback
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=""

