generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FREE
  CLIPPER
  STUDIO
  ADMIN
}

enum ProjectStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ClipStatus {
  GENERATING
  READY
  EXPORTING
  EXPORTED
  FAILED
}

enum CampaignType {
  WHOP_CONTENT_REWARDS
  BRAND_DEAL
  OWN_CHANNEL
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum SocialPlatform {
  TIKTOK
  YOUTUBE
  INSTAGRAM
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String?
  avatar               String?
  passwordHash         String?
  role                 UserRole  @default(FREE)
  canCreateCampaigns   Boolean   @default(false)
  credits              Int       @default(5)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  paddleCustomerId     String?
  paddleSubscriptionId String?
  paddlePriceId        String?
  subscriptionStatus   String?
  emailVerified        DateTime?
  notifyOnComplete     Boolean   @default(true)
  notifyOnLowCredits   Boolean   @default(true)
  notifyOnWeeklyDigest Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts                Account[]
  sessions                Session[]
  projects                Project[]
  clips                   Clip[]
  campaigns               Campaign[]
  campaignSubmissions     CampaignSubmission[]
  payouts                 Payout[]
  postingDays             PostingDay[]
  apiKeys                 ApiKey[]
  devices                 Device[]
  creditTransactions      CreditTransaction[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  socialConnections       SocialConnection[]
  socialPublishLogs       SocialPublishLog[]
  autoPilotChannels       AutoPilotChannel[]
  referredByAffiliateId   String?
  referredByAffiliate     Affiliate? @relation("UserReferral", fields: [referredByAffiliateId], references: [id], onDelete: SetNull)
  referredAt              DateTime?
  checkoutSessions        CheckoutSession[]

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([paddleCustomerId])
  @@index([paddleSubscriptionId])
  @@index([referredByAffiliateId])
}

/// One physical browser/device can ever be linked to exactly ONE account.
model Device {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the client-computed device fingerprint (canvas + hardware traits)
  fingerprintHash String   @unique
  /// Persistent random ID kept in localStorage — secondary abuse signal
  localId         String?
  userAgent       String?
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  key       String    @unique
  name      String
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id           String        @id @default(cuid())
  userId       String
  title        String
  sourceUrl    String?
  sourceFile   String? // R2 object key when uploaded directly
  duration     Int // seconds
  status       ProjectStatus @default(PENDING)
  instructions String?       @db.Text
  clipFrom     Int           @default(0) // start clipping at N seconds
  framing      String        @default("smart") // smart|face|center|blur|letter|variety
  language     String        @default("auto")
  captionStyle String        @default("hormozi") // hormozi|clean_minimal|neon_highlight|bold_impact|classic_subtitle|highlighter
  aspectRatio  String        @default("9:16") // 9:16|1:1|16:9
  transcript   Json?         // Groq/Whisper word-level transcript cache for fast clip re-trim
  creditsUsed  Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips          Clip[]
  processingJobs ProcessingJob[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ProcessingJob {
  id          String    @id @default(cuid())
  projectId   String
  type        String // "clip_generation", "render", "transcribe"
  status      String    @default("queued")
  progress    Int       @default(0)
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([projectId])
}

model Clip {
  id             String     @id @default(cuid())
  projectId      String
  userId         String
  title          String
  description    String?    @db.Text
  sourceStart    Int // seconds
  sourceEnd      Int // seconds
  duration       Int // seconds
  viralScore     Int // 0-100
  hookScore      Int?
  retentionScore Int?
  shareScore     Int?
  status         ClipStatus @default(GENERATING)
  thumbnailUrl   String?
  videoUrl       String?
  captionStyle   String     @default("hormozi")
  aspectRatio    String     @default("9:16") // 9:16|1:1|16:9
  captionData    Json? // word-level timing
  motionGraphics Json? // applied templates
  reframeData    Json? // face tracking data
  exportUrl      String?
  exportedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignLinks CampaignClip[]
  payouts       Payout[]
  publishLogs   SocialPublishLog[]

  @@index([projectId, viralScore])
  @@index([projectId, sourceStart])
  @@index([userId])
}

model Campaign {
  id          String               @id @default(cuid())
  userId      String
  name        String
  type        CampaignType         @default(BRAND_DEAL)
  platform    String? // "tiktok", "instagram", "youtube"
  platforms   Json? // ["TIKTOK", "INSTAGRAM", "YOUTUBE"]
  imageUrl    String?
  description String?              @db.Text
  rules       String?              @db.Text
  sourceUrls  Json? // ["https://youtube.com/watch?v=...", "https://drive.google.com/..."]
  ratePer1k   Decimal              @db.Decimal(10, 2)
  flatFee     Decimal?             @db.Decimal(10, 2)
  minPayout   Decimal?             @default(10.00) @db.Decimal(10, 2)
  maxPayout   Decimal?             @db.Decimal(10, 2)
  minViews    Int?                 @default(1000)
  budget      Decimal?             @db.Decimal(10, 2)
  spent       Decimal              @default(0) @db.Decimal(10, 2)
  deadline    DateTime?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips       CampaignClip[]
  payouts     Payout[]
  submissions CampaignSubmission[]

  @@index([userId])
}

model CampaignSubmission {
  id                String           @id @default(cuid())
  campaignId        String
  userId            String
  postUrl           String
  platform          String // "TIKTOK", "INSTAGRAM", "YOUTUBE"
  views             Int              @default(0)
  likes             Int              @default(0)
  comments          Int              @default(0)
  earnings          Decimal          @default(0) @db.Decimal(10, 2)
  status            SubmissionStatus @default(PENDING)
  verified          Boolean          @default(false)
  verificationNotes String?          @db.Text
  lastCheckedAt     DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([userId])
}

model CampaignClip {
  id          String    @id @default(cuid())
  campaignId  String
  clipId      String
  views       Int       @default(0)
  estEarnings Decimal   @default(0) @db.Decimal(10, 2)
  postedAt    DateTime?
  url         String?
  createdAt   DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clip     Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([campaignId, clipId])
}

model Payout {
  id          String       @id @default(cuid())
  userId      String
  campaignId  String?
  clipId      String?
  amount      Decimal      @db.Decimal(10, 2)
  status      PayoutStatus @default(PENDING)
  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime?
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clip     Clip?     @relation(fields: [clipId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model PostingDay {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  clipsPosted Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int // positive = added, negative = spent
  type        String // "purchase", "usage", "refund", "bonus"
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Setting {
  key   String @id
  value String
}

model ProcessedWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String?  @unique
  paddleEventId String?  @unique
  whopEventId   String?  @unique
  processedAt   DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SocialConnection {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform            SocialPlatform
  accessToken         String         @db.Text
  refreshToken        String?        @db.Text
  tokenExpiresAt      DateTime?
  platformAccountId   String?
  platformAccountName String?
  connectedAt         DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

model SocialPublishLog {
  id             String         @id @default(cuid())
  userId         String
  clipId         String
  platform       SocialPlatform
  externalPostId String?
  externalUrl    String?
  status         String         @default("PUBLISHED") // PUBLISHED, FAILED, PROCESSING
  errorMessage   String?
  publishedAt    DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clip Clip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([userId, clipId])
  @@index([clipId])
}

model Affiliate {
  id             String               @id @default(cuid())
  name           String
  code           String               @unique
  email          String?
  userId         String?
  commissionRate Decimal              @default(20.00) @db.Decimal(5, 2)
  isActive       Boolean              @default(true)
  notes          String?              @db.Text
  clicks         ReferralClick[]
  conversions    ReferralConversion[]
  referredUsers  User[]               @relation("UserReferral")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([code])
}

model ReferralClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  ipHash      String?
  userAgent   String?
  referer     String?
  landingPage String    @default("/")
  createdAt   DateTime  @default(now())

  @@index([affiliateId, createdAt])
}

model ReferralConversion {
  id            String    @id @default(cuid())
  affiliateId   String
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  userId        String?
  type          String // "SIGNUP", "FIRST_PROJECT", "SUBSCRIPTION"
  revenue       Decimal   @default(0) @db.Decimal(10, 2)
  commission    Decimal   @default(0) @db.Decimal(10, 2)
  stripeEventId String?
  paddleEventId String?
  createdAt     DateTime  @default(now())

  @@index([affiliateId, type, createdAt])
  @@index([userId])
}

model AutoPilotChannel {
  id             String    @id @default(cuid())
  userId         String
  channelUrl     String
  channelTitle   String?
  lastCheckedAt  DateTime?
  lastVideoId    String?
  isActive       Boolean   @default(true)
  clipsPerVideo  Int       @default(3)
  captionStyle   String    @default("hormozi")
  aspectRatio    String    @default("9:16")
  framing        String    @default("crop")
  autoApprove    Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

enum CheckoutStatus {
  INITIATED
  ABANDONED
  COMPLETED
}

model CheckoutSession {
  id            String         @id @default(cuid())
  userId        String
  userEmail     String
  userName      String?
  itemType      String         // "PLAN" or "CREDIT_PACK"
  itemId        String         // "basic", "starter", "pro", "pack_50", etc.
  itemName      String         // "Starter Plan ($29/mo)", etc.
  amount        Decimal?       @db.Decimal(10, 2)
  currency      String         @default("USD")
  paddlePriceId String?
  paddleTxId    String?
  status        CheckoutStatus @default(INITIATED)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  completedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([userEmail])
}

